{
  "name": "@emsenn/relating",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "relational-computing",
    "relational-computing-kernel"
  ],
  "description": "Relating: one boundary system where actions project to CLI, HTTP, OpenAPI, MCP, and docs from one registry, and each carrier is one JSON-Schema literal interpreted by FromSchema and the runtime validator.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.services.json && node copy-dist-assets.mjs && chmod +x dist/services/cli/main.mjs dist/services/http/main.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "examples": "node examples/material/camera-exposure.mjs && node examples/package/package-phase.mjs && node examples/package/action-projection.mjs && node examples/services/cli-exposure.mjs",
    "verify": "npm run check && npm run build && npm test && npm run examples",
    "docs:api": "typedoc",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/src/index.mjs",
  "types": "./dist/src/index.d.mts",
  "bin": {
    "relate": "./dist/services/cli/main.mjs",
    "relate-serve": "./dist/services/http/main.mjs"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "typedoc.json",
    "package.json"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.8.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.0"
  },
