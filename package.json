{
  "name": "@emsenn/relating",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Relating: one boundary system where actions project to CLI, HTTP, OpenAPI, MCP, and docs from one registry, and each carrier is a TypeBox declaration whose Static type, JSON Schema, and Ajv validator are one value.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node copy-dist-assets.mjs && chmod +x dist/scripts/*.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "npm run check && npm run build",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "relate": "./dist/scripts/cli.mjs",
    "relate-serve": "./dist/scripts/serve.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.8.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./articulating": {
      "types": "./dist/articulating/index.d.mts",
      "import": "./dist/articulating/index.mjs"
    },
    "./holography": {
      "types": "./dist/holography/index.d.mts",
      "import": "./dist/holography/index.mjs"
    },
    "./holography/projecting": {
      "types": "./dist/holography/projecting/index.d.mts",
      "import": "./dist/holography/projecting/index.mjs"
    },
    "./codecs": {
      "types": "./dist/codecs/index.d.mts",
      "import": "./dist/codecs/index.mjs"
    },
    "./codecs/http": {
      "types": "./dist/codecs/http/index.d.mts",
      "import": "./dist/codecs/http/index.mjs"
    },
    "./codecs/http/cookie": {
      "types": "./dist/codecs/http/cookie/index.d.mts",
      "import": "./dist/codecs/http/cookie/index.mjs"
    },
    "./codecs/http/compression": {
      "types": "./dist/codecs/http/compression/index.d.mts",
      "import": "./dist/codecs/http/compression/index.mjs"
    },
    "./codecs/http/multipart": {
      "types": "./dist/codecs/http/multipart/index.d.mts",
      "import": "./dist/codecs/http/multipart/index.mjs"
    },
    "./codecs/http/ws": {
      "types": "./dist/codecs/http/ws/index.d.mts",
      "import": "./dist/codecs/http/ws/index.mjs"
    },
    "./analysis": {
      "types": "./dist/articulating/predicating/positing/settling/analysis/index.d.mts",
      "import": "./dist/articulating/predicating/positing/settling/analysis/index.mjs"
    },
    "./acting": {
      "types": "./dist/acting/index.d.mts",
      "import": "./dist/acting/index.mjs"
    },
    "./acting/http": {
      "types": "./dist/acting/http.d.mts",
      "import": "./dist/acting/http.mjs"
    },
    "./typing": {
      "types": "./dist/typing/index.d.mts",
