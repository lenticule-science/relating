{
  "name": "@emsenn/relating",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Relating — paraconsistent, transfinitely-valued linear logic of relations with categorical exports and EAVT/Datom script morphisms.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && chmod +x dist/scripts/articulate-utterance.mjs dist/scripts/predicate-articulation-cell.mjs dist/scripts/posit-predication-site.mjs dist/scripts/settle-posit-presheaf.mjs",
    "test": "npm run build && rm -rf .tmp/test-dist && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*.test.mjs\"",
    "verify": "npm run check && npm run test",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "articulate-utterance": "./dist/scripts/articulate-utterance.mjs",
    "predicate-articulation-cell": "./dist/scripts/predicate-articulation-cell.mjs",
    "posit-predication-site": "./dist/scripts/posit-predication-site.mjs",
    "settle-posit-presheaf": "./dist/scripts/settle-posit-presheaf.mjs"
  },
