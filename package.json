{
  "name": "@emsenn/relating",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "license": "UNLICENSED",
  "type": "module",
  "description": "Relating: one boundary system where actions project to CLI, HTTP, OpenAPI, MCP, and docs from one registry, and each carrier is a TypeBox declaration whose Static type, JSON Schema, and Ajv validator are one value.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node copy-dist-assets.mjs && chmod +x dist/scripts/*.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "examples": "node examples/descent.mjs && node examples/action-apex.mjs && node examples/term-products.mjs && node examples/carrier-kernel.mjs && node examples/operation-substrate.mjs && node examples/morphism-inspection.mjs && node examples/witness-projection.mjs && node examples/four-charge-algebra.mjs && node examples/dihedral-gauge.mjs && node examples/relation-matrix.mjs && node examples/spatial-geometry.mjs && node examples/formal-concept-analysis.mjs && node examples/chu-spaces.mjs && node examples/settlement-analysis.mjs && node examples/representation-codecs.mjs && node examples/carrier-manifold.mjs && node examples/lean-conformance.mjs",
    "verify": "npm run check && npm run build && npm test && npm run examples",
    "docs:api": "typedoc",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/src/index.mjs",
  "types": "./dist/src/index.d.mts",
  "bin": {
    "relate": "./dist/scripts/cli.mjs",
    "relate-serve": "./dist/scripts/serve.mjs"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "typedoc.json",
    "package.json"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.8.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.mts",
      "import": "./dist/src/index.mjs"
    },
    "./articulating": {
      "types": "./dist/lib/articulating/index.d.mts",
      "import": "./dist/lib/articulating/index.mjs"
