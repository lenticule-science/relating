    },
    "./expressing/evaluating/descending": {
      "types": "./dist/expressing/evaluating/descending/index.d.mts",
      "import": "./dist/expressing/evaluating/descending/index.mjs"
    },
    "./expressing/evaluating/reading": {
      "types": "./dist/expressing/evaluating/reading/index.d.mts",
      "import": "./dist/expressing/evaluating/reading/index.mjs"
    },
    "./expressing/evaluating/measuring": {
      "types": "./dist/expressing/evaluating/measuring/index.d.mts",
