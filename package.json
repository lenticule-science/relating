{
  "name": "@emsenn/relating",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Relating — paraconsistent, transfinitely-valued linear logic of relations with categorical exports and EAVT/Datom script morphisms.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/package-boundary/copy-dmts-to-dts.mjs dist",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*.test.mjs\"",
    "verify": "npm run check && npm run build",
    "prepack": "npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "eval-relation": "./dist/scripts/evaluate.mjs",
    "relating-read": "./dist/scripts/read.mjs",
    "relating-compare": "./dist/scripts/compare.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./articulating": {
      "types": "./dist/articulating/index.d.ts",
      "import": "./dist/articulating/index.mjs"
    },
    "./articulating/predicating": {
      "types": "./dist/articulating/predicating/index.d.ts",
      "import": "./dist/articulating/predicating/index.mjs"
    },
