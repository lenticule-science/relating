{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relating/articulating/predicating/positing/meme",
  "title": "Meme",
  "description": "The minimal transmissible unit of meaning-with-evidence: a predication cell bound to a bilattice charge. The domain and codomain carrier communicating is endomorphic on (meme -> meme). A cell's subject/object Marks may wrap any value, so a whole section can nest as the subject or object of a meme.",
  "type": "object",
  "required": ["kind", "cell", "charge"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "predication.fiber.meme" },
    "cell": { "$ref": "#/$defs/Cell" },
    "charge": { "$ref": "#/$defs/ChargeCarrier" }
  },
  "$defs": {
    "Mark": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "utterance.mark" },
        "value": {}
      }
    },
    "Token": {
      "type": "object",
      "required": ["kind", "hand", "mark"],
      "properties": {
        "kind": { "const": "utterance.token" },
        "hand": { "const": "left" },
        "mark": { "$ref": "#/$defs/Mark" }
      }
    },
    "Claim": {
      "type": "object",
      "required": ["kind", "hand", "mark"],
      "properties": {
        "kind": { "const": "utterance.claim" },
        "hand": { "const": "right" },
        "mark": { "$ref": "#/$defs/Mark" }
      }
    },
    "Predicate": {
      "type": "object",
      "required": ["kind", "claim", "mark"],
      "properties": {
        "kind": { "const": "predication.predicate" },
        "claim": { "$ref": "#/$defs/Claim" },
        "mark": { "$ref": "#/$defs/Mark" }
      }
    },
    "Cell": {
      "type": "object",
      "required": ["subject", "predicate", "object"],
      "properties": {
        "subject": { "$ref": "#/$defs/Token" },
        "predicate": { "$ref": "#/$defs/Predicate" },
        "object": { "$ref": "#/$defs/Token" }
      }
    },
    "ChargeSide": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "bilattice-charge.side" },
        "name": { "enum": ["absent", "present"] }
      }
    },
    "ChargeCarrier": {
      "type": "object",
      "required": ["kind", "value", "evidence"],
      "description": "A charge bearing evidence: the [truth, falsity] side coordinates and the witness Marks per side.",
      "properties": {
        "kind": { "const": "bilattice-charge.carrier" },
        "value": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/ChargeSide" }, { "$ref": "#/$defs/ChargeSide" }],
          "items": false
        },
        "evidence": {
          "type": "array",
          "prefixItems": [
            { "type": "array", "items": { "$ref": "#/$defs/Mark" } },
            { "type": "array", "items": { "$ref": "#/$defs/Mark" } }
          ],
          "items": false
        }
      }
    }
  }
}
